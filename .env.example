# Database URLs (PostgreSQL 15+)
DATABASE_URL="postgresql://user:password@host:5432/edusmart_db?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/edusmart_db?sslmode=require"

# JWT & Authentication Secret (At least 32 characters)
AUTH_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"

# Optional Distributed Cache (Redis)
REDIS_URL="redis://localhost:6379"

# Next.js Public Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
