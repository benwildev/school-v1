  reservationDate DateTime @map("reservation_date")          @default(now()) @db.Timestamptz()
  expiryDate      DateTime @map("expiry_date")          @db.Timestamptz()
  fulfilledDate   DateTime? @map("fulfilled_date")         @db.Timestamptz()
  fulfilledCopyId String? @map("fulfilled_copy_id")           @db.Uuid
  status          ReservationStatus @default(PENDING)
  notes           String?           @db.Text
  createdAt       DateTime @map("created_at")          @default(now()) @db.Timestamptz()
  updatedAt       DateTime @map("updated_at")          @default(now()) @updatedAt @db.Timestamptz()

  school        School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  book          LibraryBook      @relation(fields: [bookId], references: [id], onDelete: Restrict)
  student       Student?         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  employee      Employee?        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fulfilledCopy LibraryBookCopy? @relation(fields: [fulfilledCopyId], references: [id], onDelete: SetNull)

  @@unique([id, schoolId])
  @@index([schoolId, bookId, status])
  @@index([schoolId, studentId])
  @@index([schoolId, employeeId])
  @@map("library_reservations")
}

model LibraryFine {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String @map("school_id")            @db.Uuid
  loanId           String? @map("loan_id")           @db.Uuid
  borrowerType     BorrowerType @map("borrower_type")
  studentId        String? @map("student_id")           @db.Uuid
  employeeId       String? @map("employee_id")           @db.Uuid
  fineType         LibraryFineType @map("fine_type")   @default(OVERDUE)
  overdueDays      Int @map("overdue_days")               @default(0)
  dailyRate        Decimal @map("daily_rate")           @default(0.00) @db.Decimal(12, 2)
  calculatedAmount Decimal @map("calculated_amount")           @default(0.00) @db.Decimal(12, 2)
  fineAmount       Decimal @map("fine_amount")           @default(0.00) @db.Decimal(12, 2)
  waivedAmount     Decimal @map("waived_amount")           @default(0.00) @db.Decimal(12, 2)
  paidAmount       Decimal @map("paid_amount")           @default(0.00) @db.Decimal(12, 2)
  status           LibraryFineStatus @default(UNPAID)
  studentFeeId     String? @map("student_fee_id")           @db.Uuid
  assessedById     String? @map("assessed_by_id")           @db.Uuid
  waivedById       String? @map("waived_by_id")           @db.Uuid
  waivedReason     String? @map("waived_reason")           @db.Text
  notes            String?           @db.Text
  createdAt        DateTime @map("created_at")          @default(now()) @db.Timestamptz()
  updatedAt        DateTime @map("updated_at")          @default(now()) @updatedAt @db.Timestamptz()

  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  loan       LibraryLoan? @relation(fields: [loanId], references: [id], onDelete: SetNull)
  student    Student?     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  employee   Employee?    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  studentFee StudentFee?  @relation(fields: [studentFeeId], references: [id], onDelete: SetNull)
  assessedBy User?        @relation("AssessedLibraryFines", fields: [assessedById], references: [id], onDelete: SetNull)
  waivedBy   User?        @relation("WaivedLibraryFines", fields: [waivedById], references: [id], onDelete: SetNull)

  @@unique([id, schoolId])
  @@index([schoolId, status])
  @@index([schoolId, loanId])
  @@index([schoolId, studentId])
  @@index([schoolId, employeeId])
  @@map("library_fines")
}

// ============================================================================
// DOMAIN 20: INVENTORY & ASSET MANAGEMENT (PHASE 10)
// ============================================================================

model InventoryCategory {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String @map("school_id")            @db.Uuid
  code        String            @db.VarChar(50)
  nameEn      String @map("name_en")            @db.VarChar(100)
  nameBn      String @map("name_bn")            @db.VarChar(100)
  itemType    InventoryItemType @map("item_type") @default(CONSUMABLE)
  description String?           @db.Text
  status      RecordStatus      @default(ACTIVE)
  createdAt   DateTime @map("created_at")          @default(now()) @db.Timestamptz()
  updatedAt   DateTime @map("updated_at")          @default(now()) @updatedAt @db.Timestamptz()

  school School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  items  InventoryItem[]

  @@unique([id, schoolId])
  @@unique([schoolId, code])
  @@index([schoolId, status])
  @@map("inventory_categories")
}

model InventoryItem {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String @map("school_id")            @db.Uuid
  categoryId    String @map("category_id")            @db.Uuid
  itemCode      String @map("item_code")            @db.VarChar(50)
  nameEn        String @map("name_en")            @db.VarChar(150)
  nameBn        String? @map("name_bn")           @db.VarChar(150)
  itemType      InventoryItemType @map("item_type") @default(CONSUMABLE)
  stockUnit     StockUnit @map("stock_unit")         @default(PCS)
  minStockLevel Int @map("min_stock_level")               @default(0)
  reorderLevel  Int @map("reorder_level")               @default(0)
  description   String?           @db.Text
  status        RecordStatus      @default(ACTIVE)
  createdAt     DateTime @map("created_at")          @default(now()) @db.Timestamptz()
  updatedAt     DateTime @map("updated_at")          @default(now()) @updatedAt @db.Timestamptz()

  school         School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category       InventoryCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  purchaseItems  InventoryPurchaseItem[]
  stockMovements StockMovement[]
  transfers      InventoryTransfer[]
  assets         Asset[]

  @@unique([id, schoolId])
  @@unique([schoolId, itemCode])
  @@index([schoolId, status])
  @@index([schoolId, categoryId])
  @@map("inventory_items")
}

model InventorySupplier {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String @map("school_id")       @db.Uuid
  supplierCode  String @map("supplier_code")       @db.VarChar(50)
  name          String       @db.VarChar(150)
  companyName   String? @map("company_name")      @db.VarChar(150)
  contactPerson String? @map("contact_person")      @db.VarChar(100)
  phone         String?      @db.VarChar(50)
  email         String?      @db.VarChar(100)
  address       String?      @db.Text
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime @map("created_at")     @default(now()) @db.Timestamptz()
  updatedAt     DateTime @map("updated_at")     @default(now()) @updatedAt @db.Timestamptz()

  school    School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  purchases InventoryPurchase[]

  @@unique([id, schoolId])
  @@unique([schoolId, supplierCode])
  @@index([schoolId, status])
  @@map("inventory_suppliers")
}

model InventoryPurchase {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String @map("school_id")         @db.Uuid
  campusId       String? @map("campus_id")        @db.Uuid
  supplierId     String @map("supplier_id")         @db.Uuid
  purchaseNumber String @map("purchase_number")         @db.VarChar(50)
  invoiceNumber  String? @map("invoice_number")        @db.VarChar(100)
  purchaseDate   DateTime @map("purchase_date")       @db.Date
  receivedDate   DateTime? @map("received_date")      @db.Date
  totalAmount    Decimal @map("total_amount")        @default(0.00) @db.Decimal(12, 2)
  status         PurchaseStatus @default(ORDERED)
  notes          String?        @db.Text
  createdById    String? @map("created_by_id")        @db.Uuid
  createdAt      DateTime @map("created_at")       @default(now()) @db.Timestamptz()
  updatedAt      DateTime @map("updated_at")       @default(now()) @updatedAt @db.Timestamptz()

  school    School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus    Campus?                 @relation(fields: [campusId], references: [id], onDelete: SetNull)
  supplier  InventorySupplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy User?                   @relation("CreatedPurchases", fields: [createdById], references: [id], onDelete: SetNull)
  items     InventoryPurchaseItem[]

  @@unique([id, schoolId])
  @@unique([schoolId, purchaseNumber])
  @@index([schoolId, status])
  @@index([schoolId, supplierId])
  @@map("inventory_purchases")
}

model InventoryPurchaseItem {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String @map("school_id")   @db.Uuid
  purchaseId       String @map("purchase_id")   @db.Uuid
  itemId           String @map("item_id")   @db.Uuid
  quantity         Int
  unitCost         Decimal @map("unit_cost")  @db.Decimal(12, 2)
  totalCost        Decimal @map("total_cost")  @db.Decimal(12, 2)
  receivedQuantity Int @map("received_quantity")      @default(0)
  createdAt        DateTime @map("created_at") @default(now()) @db.Timestamptz()
  updatedAt        DateTime @map("updated_at") @default(now()) @updatedAt @db.Timestamptz()

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  purchase InventoryPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item     InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([id, schoolId])
  @@index([schoolId, purchaseId])
  @@index([schoolId, itemId])
  @@map("inventory_purchase_items")
}

model StockMovement {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId            String @map("school_id")            @db.Uuid
  itemId              String @map("item_id")            @db.Uuid
  campusId            String @map("campus_id")            @db.Uuid
  movementType        StockMovementType @map("movement_type")
  quantity            Int
  unitCost            Decimal @map("unit_cost")           @default(0.00) @db.Decimal(12, 2)
  totalCost           Decimal @map("total_cost")           @default(0.00) @db.Decimal(12, 2)
  sourceCampusId      String? @map("source_campus_id")           @db.Uuid
  destinationCampusId String? @map("destination_campus_id")           @db.Uuid
  recipientEmployeeId String? @map("recipient_employee_id")           @db.Uuid
  referenceType       String? @map("reference_type")           @db.VarChar(50)
  referenceId         String? @map("reference_id")           @db.Uuid
  notes               String?           @db.Text
  createdById         String @map("created_by_id")            @db.Uuid
  createdAt           DateTime @map("created_at")          @default(now()) @db.Timestamptz()

  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  campus            Campus        @relation(fields: [campusId], references: [id], onDelete: Restrict)
  recipientEmployee Employee?     @relation(fields: [recipientEmployeeId], references: [id], onDelete: SetNull)
  createdBy         User          @relation("CreatedStockMovements", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([id, schoolId])
  @@index([schoolId, itemId, campusId])
  @@index([schoolId, movementType])
  @@index([schoolId, createdAt])
  @@map("stock_movements")
}

model InventoryTransfer {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId            String @map("school_id")   @db.Uuid
  transferNumber      String @map("transfer_number")   @db.VarChar(50)
  itemId              String @map("item_id")   @db.Uuid
  sourceCampusId      String @map("source_campus_id")   @db.Uuid
  destinationCampusId String @map("destination_campus_id")   @db.Uuid
  quantity            Int
  transferDate        DateTime @map("transfer_date") @default(now()) @db.Date
  reason              String?  @db.Text
  initiatedById       String @map("initiated_by_id")   @db.Uuid
  status              String   @default("COMPLETED") @db.VarChar(20)
  createdAt           DateTime @map("created_at") @default(now()) @db.Timestamptz()
  updatedAt           DateTime @map("updated_at") @default(now()) @updatedAt @db.Timestamptz()

  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  sourceCampus      Campus        @relation("TransferSourceCampus", fields: [sourceCampusId], references: [id], onDelete: Restrict)
  destinationCampus Campus        @relation("TransferDestinationCampus", fields: [destinationCampusId], references: [id], onDelete: Restrict)
  initiatedBy       User          @relation("InitiatedTransfers", fields: [initiatedById], references: [id], onDelete: Restrict)

  @@unique([id, schoolId])
  @@unique([schoolId, transferNumber])
  @@index([schoolId, itemId])
  @@map("inventory_transfers")
}

model Asset {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId            String @map("school_id")          @db.Uuid
  itemId              String @map("item_id")          @db.Uuid
  campusId            String @map("campus_id")          @db.Uuid
  assetCode           String @map("asset_code")          @db.VarChar(100)
  serialNumber        String? @map("serial_number")         @db.VarChar(100)
  barcode             String?         @db.VarChar(100)
  modelNumber         String? @map("model_number")         @db.VarChar(100)
  purchaseDate        DateTime? @map("purchase_date")       @db.Date
  purchaseCost        Decimal @map("purchase_cost")         @default(0.00) @db.Decimal(12, 2)
  warrantyExpiry      DateTime? @map("warranty_expiry")       @db.Date
  currentCondition    AssetCondition @map("current_condition")  @default(NEW)
  status              AssetStatus     @default(AVAILABLE)
  assignedEmployeeId  String? @map("assigned_employee_id")         @db.Uuid
  locationClassroomId String? @map("location_classroom_id")         @db.Uuid
  roomLocation        String? @map("room_location")         @db.VarChar(150)
  disposalDate        DateTime? @map("disposal_date")       @db.Date
  disposalReason      String? @map("disposal_reason")         @db.Text
  disposalValue       Decimal? @map("disposal_value")        @db.Decimal(12, 2)
  disposedById        String? @map("disposed_by_id")         @db.Uuid
  notes               String?         @db.Text
  createdAt           DateTime @map("created_at")        @default(now()) @db.Timestamptz()
  updatedAt           DateTime @map("updated_at")        @default(now()) @updatedAt @db.Timestamptz()

  school            School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  item              InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  campus            Campus                @relation(fields: [campusId], references: [id], onDelete: Restrict)
  assignedEmployee  Employee?             @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  locationClassroom Classroom?            @relation(fields: [locationClassroomId], references: [id], onDelete: SetNull)
  disposedBy        User?                 @relation("DisposedAssets", fields: [disposedById], references: [id], onDelete: SetNull)
  assignments       AssetAssignment[]
  maintenanceLogs   AssetMaintenanceLog[]

  @@unique([id, schoolId])
  @@unique([schoolId, assetCode])
  @@index([schoolId, status])
  @@index([schoolId, itemId])
  @@index([schoolId, campusId])
  @@index([schoolId, assignedEmployeeId])
  @@map("assets")
}

model AssetAssignment {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId              String @map("school_id")          @db.Uuid
  assetId               String @map("asset_id")          @db.Uuid
  employeeId            String? @map("employee_id")         @db.Uuid
  campusId              String? @map("campus_id")         @db.Uuid
  classroomId           String? @map("classroom_id")         @db.Uuid
  locationName          String? @map("location_name")         @db.VarChar(150)
  assignedDate          DateTime @map("assigned_date")        @default(now()) @db.Timestamptz()
  returnedDate          DateTime? @map("returned_date")       @db.Timestamptz()
  conditionOnAssignment AssetCondition @map("condition_on_assignment")  @default(GOOD)
  conditionOnReturn     AssetCondition? @map("condition_on_return")
  assignedById          String @map("assigned_by_id")          @db.Uuid
  notes                 String?         @db.Text
  createdAt             DateTime @map("created_at")        @default(now()) @db.Timestamptz()
  updatedAt             DateTime @map("updated_at")        @default(now()) @updatedAt @db.Timestamptz()

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  asset      Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee   Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  campus     Campus?    @relation(fields: [campusId], references: [id], onDelete: SetNull)
  classroom  Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  assignedBy User       @relation("AssignedAssets", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([id, schoolId])
  @@index([schoolId, assetId])
  @@index([schoolId, employeeId])
  @@map("asset_assignments")
}

model AssetMaintenanceLog {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String @map("school_id")    @db.Uuid
  assetId          String @map("asset_id")    @db.Uuid
  maintenanceType  String @map("maintenance_type")    @db.VarChar(100)
  serviceDate      DateTime @map("service_date")  @db.Date
  vendorName       String? @map("vendor_name")   @db.VarChar(150)
  issueDescription String? @map("issue_description")   @db.Text
  cost             Decimal   @default(0.00) @db.Decimal(12, 2)
  status           String    @default("COMPLETED") @db.VarChar(50)
  nextServiceDate  DateTime? @map("next_service_date") @db.Date
  notes            String?   @db.Text
  createdById      String? @map("created_by_id")   @db.Uuid
  createdAt        DateTime @map("created_at")  @default(now()) @db.Timestamptz()
  updatedAt        DateTime @map("updated_at")  @default(now()) @updatedAt @db.Timestamptz()

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("CreatedAssetMaintenance", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([id, schoolId])
  @@index([schoolId, assetId])
  @@index([schoolId, serviceDate])
  @@map("asset_maintenance_logs")
}

// ============================================================================
// DOMAIN 26: ADVANCED REPORTING & ANALYTICS
// ============================================================================

model SavedReport {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String @map("school_id")   @db.Uuid
  userId      String @map("user_id")   @db.Uuid
  reportId    String @map("report_id")   @db.VarChar(100)
  name        String   @db.VarChar(200)
  nameBn      String? @map("name_bn")  @db.VarChar(200)
  description String?  @db.Text
  filters     Json     @default("{}")
  columns     Json?
  sortBy      String? @map("sort_by")  @db.VarChar(100)
  sortOrder   String? @map("sort_order")  @default("ASC") @db.VarChar(10)
  isPinned    Boolean @map("is_pinned")  @default(false)
  createdAt   DateTime @map("created_at") @default(now()) @db.Timestamptz()
  updatedAt   DateTime @map("updated_at") @default(now()) @updatedAt @db.Timestamptz()

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, schoolId])
  @@index([schoolId, userId, reportId])
  @@map("saved_reports")
}

model ReportExportLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String @map("school_id")   @db.Uuid
  userId      String @map("user_id")   @db.Uuid
  reportId    String @map("report_id")   @db.VarChar(100)
  format      String   @db.VarChar(20)
  filters     Json     @default("{}")
  resultCount Int @map("result_count")      @default(0)
  ipAddress   String? @map("ip_address")  @db.VarChar(45)
  userAgent   String? @map("user_agent")  @db.Text
  createdAt   DateTime @map("created_at") @default(now()) @db.Timestamptz()

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, schoolId])
  @@index([schoolId, reportId, createdAt])
  @@index([schoolId, userId, createdAt])
  @@map("report_export_logs")
}


