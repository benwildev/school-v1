model LibrarySetting {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId                  String   @unique @db.Uuid
  studentMaxBooks           Int      @default(3)
  studentLoanPeriodDays     Int      @default(14)
  studentMaxRenewals        Int      @default(2)
  employeeMaxBooks          Int      @default(10)
  employeeLoanPeriodDays    Int      @default(30)
  employeeMaxRenewals       Int      @default(3)
