// ============================================================================
// DOMAIN 01: SCHOOL & CAMPUS
// ============================================================================

model School {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String       @unique @db.VarChar(100)
  nameEn          String @map("name_en")       @db.VarChar(255)
  nameBn          String @map("name_bn")       @db.VarChar(255)
  eiin            String?      @db.VarChar(20)
  boardCode       String? @map("board_code")      @db.VarChar(20)
  registrationNo  String? @map("registration_no")      @db.VarChar(50)
  establishedYear Int? @map("established_year")
  email           String       @db.VarChar(255)
  phone           String       @db.VarChar(30)
  alternatePhone  String? @map("alternate_phone")      @db.VarChar(30)
  website         String?      @db.VarChar(255)
  currency        String       @default("BDT") @db.VarChar(10)
  locale          String       @default("bn-BD") @db.VarChar(10)
  status          SchoolStatus @default(ACTIVE)
  createdAt       DateTime @map("created_at")     @default(now()) @db.Timestamptz()
  updatedAt       DateTime @map("updated_at")     @default(now()) @updatedAt @db.Timestamptz()
  deletedAt       DateTime? @map("deleted_at")    @db.Timestamptz()

  campuses                 Campus[]
  settings                 SchoolSettings?
  branding                 SchoolBranding?
  addresses                SchoolAddress[]
  academicSessions         AcademicSession[]
  classes                  Class[]
  groups                   AcademicGroup[]
  sections                 Section[]
  subjects                 Subject[]
  subjectAssessmentConfigs SubjectAssessmentConfig[]
  classrooms               Classroom[]
  routines                 Routine[]
  academicCalendars        AcademicCalendar[]
  students                 Student[]
  guardians                Guardian[]
  studentGuardians         StudentGuardian[]
  enrollments              Enrollment[]
  promotionBatches         PromotionBatch[]
  studentDocuments         StudentDocument[]
  teachers                 Teacher[]
  teacherAssignments       TeacherAssignment[]
  studentAttendances       StudentAttendance[]
  employeeAttendances      EmployeeAttendance[]
  exams                    Exam[]
  examSchedules            ExamSchedule[]
  gradingScales            GradingScale[]
  marks                    Mark[]
  studentExamResults       StudentExamResult[]
  feeTypes                 FeeType[]
  feeStructures            FeeStructure[]
  studentFees              StudentFee[]
  studentDiscounts         StudentDiscount[]
  payments                 Payment[]
  paymentAllocations       PaymentAllocation[]
  creditAccounts           StudentCreditAccount[]
  creditTransactions       StudentCreditTransaction[]
  receipts                 Receipt[]
  refunds                  Refund[]
  expenses                 Expense[]
  expenseCategories        ExpenseCategory[]
  admissionApplications    AdmissionApplication[]
  users                    User[]
  roles                    Role[]
  auditLogs                AuditLog[]
  fileAttachments          FileAttachment[]
  certificates             Certificate[]
  notifications            Notification[]
  messageLogs              MessageLog[]
  notificationTemplates    NotificationTemplate[]
  automationRules          AutomationRule[]
  integrationConfigs       IntegrationConfig[]
  biometricDevices         BiometricDevice[]
  subscription             SchoolSubscription?
  subscriptionPeriods      SubscriptionPeriod[]
  usageMetrics             PlatformUsageMetric[]
  usageEvents              UsageEvent[]
  studentUsers             StudentUser[]
  accountInvitations       AccountInvitation[]
  departments              Department[]
  designations             Designation[]
  employees                Employee[]
  employeeDocuments        EmployeeDocument[]
  salaryComponents         SalaryComponent[]
  salaryStructures         SalaryStructure[]
  salaryStructureItems     SalaryStructureItem[]
  salaryAssignments        EmployeeSalaryAssignment[]
  employeeSalaryItems      EmployeeSalaryItem[]
  leaveTypes               LeaveType[]
  leaveBalances            LeaveBalance[]
  leaveRequests            LeaveRequest[]
  salaryAdvances           SalaryAdvance[]
  advanceRepaymentLogs     AdvanceRepaymentLog[]
  payrollPeriods           PayrollPeriod[]
  payrollRecords           PayrollRecord[]
  payrollItems             PayrollItem[]
  payrollPayments          PayrollPayment[]
  rawAttendanceEvents      RawAttendanceEvent[]
  attendanceRules          AttendanceRule[]
  employeeShifts           EmployeeShift[]
  attendanceCorrections    AttendanceCorrection[]
  communicationCampaigns   CommunicationCampaign[]
  notificationPreferences  NotificationPreference[]
  vehicles                 Vehicle[]
  transportRoutes          TransportRoute[]
  routeStops               RouteStop[]
  vehicleDriverAssignments VehicleDriverAssignment[]
  studentTransportAssignments StudentTransportAssignment[]
  transportTrips           TransportTrip[]
  transportBoardingEvents  TransportBoardingEvent[]
  vehicleMaintenanceLogs   VehicleMaintenanceLog[]
  librarySettings          LibrarySetting?
  libraryCategories        LibraryCategory[]
  libraryAuthors           LibraryAuthor[]
  libraryPublishers        LibraryPublisher[]
  libraryBooks             LibraryBook[]
  libraryBookCopies        LibraryBookCopy[]
  libraryLoans             LibraryLoan[]
  libraryReservations      LibraryReservation[]
  libraryFines             LibraryFine[]
  inventoryCategories      InventoryCategory[]
  inventoryItems           InventoryItem[]
  inventorySuppliers       InventorySupplier[]
  inventoryPurchases       InventoryPurchase[]
  inventoryPurchaseItems   InventoryPurchaseItem[]
  stockMovements           StockMovement[]
  inventoryTransfers       InventoryTransfer[]
  assets                   Asset[]
  assetAssignments         AssetAssignment[]
  assetMaintenanceLogs     AssetMaintenanceLog[]
  savedReports             SavedReport[]
  reportExportLogs         ReportExportLog[]

  @@map("schools")
}

model Campus {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String @map("school_id")       @db.Uuid
  code          String       @db.VarChar(20)
  nameEn        String @map("name_en")       @db.VarChar(255)
  nameBn        String @map("name_bn")       @db.VarChar(255)
  phone         String?      @db.VarChar(30)
  email         String?      @db.VarChar(255)
  principalName String? @map("principal_name")      @db.VarChar(150)
  isMainBranch  Boolean @map("is_main_branch")      @default(false)
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime @map("created_at")     @default(now()) @db.Timestamptz()
  updatedAt     DateTime @map("updated_at")     @default(now()) @updatedAt @db.Timestamptz()
  deletedAt     DateTime? @map("deleted_at")    @db.Timestamptz()

  school           School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  sections         Section[]
  classrooms       Classroom[]
  enrollments      Enrollment[]
  teachers         Teacher[]
  expenses         Expense[]
  biometricDevices BiometricDevice[]
  userRoles        UserRole[]
  addresses        SchoolAddress[]
  admissionApps    AdmissionApplication[]
  employees        Employee[]
  payrollRecords   PayrollRecord[]
  attendanceRules  AttendanceRule[]
  vehicles                 Vehicle[]
  transportRoutes          TransportRoute[]
  libraryBookCopies        LibraryBookCopy[]
  inventoryPurchases       InventoryPurchase[]
  stockMovements           StockMovement[]
  transfersSource          InventoryTransfer[]        @relation("TransferSourceCampus")
  transfersDestination     InventoryTransfer[]        @relation("TransferDestinationCampus")
  assets                   Asset[]
  assetAssignments         AssetAssignment[]

  @@unique([id, schoolId])
  @@unique([schoolId, code])
  @@map("campuses")
}

model SchoolSettings {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId             String @map("school_id")         @unique @db.Uuid
  activeSessionId      String? @map("active_session_id")        @db.Uuid
  attendanceType       AttendanceType @map("attendance_type") @default(DAILY)
  enableSmsAlerts      Boolean @map("enable_sms_alerts")        @default(false)
  enableWhatsappAlerts Boolean @map("enable_whatsapp_alerts")        @default(false)
  enableBiometric      Boolean @map("enable_biometric")        @default(false)
  enableOnlinePayment  Boolean @map("enable_online_payment")        @default(false)
  allowPublicAdmission Boolean @map("allow_public_admission")        @default(false)
  timezone             String         @default("Asia/Dhaka") @db.VarChar(50)
  financialYearStart   Int @map("financial_year_start")            @default(1)
  receiptHeaderBn      String? @map("receipt_header_bn")        @db.Text
  receiptHeaderEn      String? @map("receipt_header_en")        @db.Text
  receiptFooterNote    String? @map("receipt_footer_note")        @db.Text
  customAttributes     Json @map("custom_attributes")           @default("{}")
  updatedAt            DateTime @map("updated_at")       @default(now()) @updatedAt @db.Timestamptz()

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_settings")
}

model SchoolBranding {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId               String @map("school_id")   @unique @db.Uuid
  logoUrl                String? @map("logo_url")  @db.Text
  faviconUrl             String? @map("favicon_url")  @db.Text
  monogramUrl            String? @map("monogram_url")  @db.Text
  principalSignatureUrl  String? @map("principal_signature_url")  @db.Text
  headmasterSignatureUrl String? @map("headmaster_signature_url")  @db.Text
  officialSealUrl        String? @map("official_seal_url")  @db.Text
  primaryColor           String @map("primary_color")   @default("#166534") @db.VarChar(20)
  secondaryColor         String @map("secondary_color")   @default("#0f172a") @db.VarChar(20)
  accentColor            String @map("accent_color")   @default("#eab308") @db.VarChar(20)
  idCardTemplate         String @map("id_card_template")   @default("CLASSIC_CLEAN") @db.VarChar(50)
  reportCardTemplate     String @map("report_card_template")   @default("BANGLADESH_STANDARD") @db.VarChar(50)
  updatedAt              DateTime @map("updated_at") @default(now()) @updatedAt @db.Timestamptz()

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_branding")
}

model SchoolAddress {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String @map("school_id")   @db.Uuid
  campusId     String? @map("campus_id")  @db.Uuid
  addressLine1 String @map("address_line1")   @db.Text
  addressLine2 String? @map("address_line2")  @db.Text
  postOffice   String @map("post_office")   @db.VarChar(100)
  postCode     String @map("post_code")   @db.VarChar(20)
  thana        String   @db.VarChar(100)
  district     String   @db.VarChar(100)
  division     Division
  country      String   @default("Bangladesh") @db.VarChar(100)
  isPrimary    Boolean @map("is_primary")  @default(true)
  createdAt    DateTime @map("created_at") @default(now()) @db.Timestamptz()

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@map("school_addresses")
}

// ============================================================================
// DOMAIN 02: ACADEMIC STRUCTURE & TIMETABLE
// ============================================================================

model AcademicSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String @map("school_id")   @db.Uuid
  name      String   @db.VarChar(100)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
