  calculatedAmount Decimal           @default(0.00) @db.Decimal(12, 2)
  fineAmount       Decimal           @default(0.00) @db.Decimal(12, 2)
  waivedAmount     Decimal           @default(0.00) @db.Decimal(12, 2)
  paidAmount       Decimal           @default(0.00) @db.Decimal(12, 2)
  status           LibraryFineStatus @default(UNPAID)
  studentFeeId     String?           @db.Uuid
  assessedById     String?           @db.Uuid
  waivedById       String?           @db.Uuid
  waivedReason     String?           @db.Text
  notes            String?           @db.Text
  createdAt        DateTime          @default(now()) @db.Timestamptz()
  updatedAt        DateTime          @default(now()) @updatedAt @db.Timestamptz()

  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  loan       LibraryLoan? @relation(fields: [loanId], references: [id], onDelete: SetNull)
  student    Student?     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  employee   Employee?    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  studentFee StudentFee?  @relation(fields: [studentFeeId], references: [id], onDelete: SetNull)
  assessedBy User?        @relation("AssessedLibraryFines", fields: [assessedById], references: [id], onDelete: SetNull)
  waivedBy   User?        @relation("WaivedLibraryFines", fields: [waivedById], references: [id], onDelete: SetNull)

  @@unique([id, schoolId])
  @@index([schoolId, status])
  @@index([schoolId, loanId])
  @@index([schoolId, studentId])
  @@index([schoolId, employeeId])
  @@map("library_fines")
}

// ============================================================================
// DOMAIN 20: INVENTORY & ASSET MANAGEMENT (PHASE 10)
// ============================================================================

model InventoryCategory {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String            @db.Uuid
  code        String            @db.VarChar(50)
  nameEn      String            @db.VarChar(100)
  nameBn      String            @db.VarChar(100)
  itemType    InventoryItemType @default(CONSUMABLE)
  description String?           @db.Text
  status      RecordStatus      @default(ACTIVE)
  createdAt   DateTime          @default(now()) @db.Timestamptz()
  updatedAt   DateTime          @default(now()) @updatedAt @db.Timestamptz()

  school School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  items  InventoryItem[]

  @@unique([id, schoolId])
  @@unique([schoolId, code])
  @@index([schoolId, status])
  @@map("inventory_categories")
}

model InventoryItem {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String            @db.Uuid
  categoryId    String            @db.Uuid
  itemCode      String            @db.VarChar(50)
  nameEn        String            @db.VarChar(150)
  nameBn        String?           @db.VarChar(150)
  itemType      InventoryItemType @default(CONSUMABLE)
  stockUnit     StockUnit         @default(PCS)
  minStockLevel Int               @default(0)
  reorderLevel  Int               @default(0)
  description   String?           @db.Text
  status        RecordStatus      @default(ACTIVE)
  createdAt     DateTime          @default(now()) @db.Timestamptz()
  updatedAt     DateTime          @default(now()) @updatedAt @db.Timestamptz()

  school         School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category       InventoryCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  purchaseItems  InventoryPurchaseItem[]
  stockMovements StockMovement[]
  transfers      InventoryTransfer[]
  assets         Asset[]

  @@unique([id, schoolId])
  @@unique([schoolId, itemCode])
  @@index([schoolId, status])
  @@index([schoolId, categoryId])
  @@map("inventory_items")
}

model InventorySupplier {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String       @db.Uuid
  supplierCode  String       @db.VarChar(50)
  name          String       @db.VarChar(150)
  companyName   String?      @db.VarChar(150)
  contactPerson String?      @db.VarChar(100)
  phone         String?      @db.VarChar(50)
  email         String?      @db.VarChar(100)
  address       String?      @db.Text
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @db.Timestamptz()
  updatedAt     DateTime     @default(now()) @updatedAt @db.Timestamptz()

  school    School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  purchases InventoryPurchase[]

  @@unique([id, schoolId])
  @@unique([schoolId, supplierCode])
  @@index([schoolId, status])
  @@map("inventory_suppliers")
}

model InventoryPurchase {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String         @db.Uuid
  campusId       String?        @db.Uuid
  supplierId     String         @db.Uuid
  purchaseNumber String         @db.VarChar(50)
  invoiceNumber  String?        @db.VarChar(100)
  purchaseDate   DateTime       @db.Date
  receivedDate   DateTime?      @db.Date
  totalAmount    Decimal        @default(0.00) @db.Decimal(12, 2)
  status         PurchaseStatus @default(ORDERED)
  notes          String?        @db.Text
  createdById    String?        @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz()
  updatedAt      DateTime       @default(now()) @updatedAt @db.Timestamptz()

  school    School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus    Campus?                 @relation(fields: [campusId], references: [id], onDelete: SetNull)
  supplier  InventorySupplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy User?                   @relation("CreatedPurchases", fields: [createdById], references: [id], onDelete: SetNull)
  items     InventoryPurchaseItem[]

  @@unique([id, schoolId])
  @@unique([schoolId, purchaseNumber])
  @@index([schoolId, status])
  @@index([schoolId, supplierId])
  @@map("inventory_purchases")
}

model InventoryPurchaseItem {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String   @db.Uuid
  purchaseId       String   @db.Uuid
  itemId           String   @db.Uuid
  quantity         Int
  unitCost         Decimal  @db.Decimal(12, 2)
  totalCost        Decimal  @db.Decimal(12, 2)
  receivedQuantity Int      @default(0)
  createdAt        DateTime @default(now()) @db.Timestamptz()
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz()

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  purchase InventoryPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item     InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([id, schoolId])
  @@index([schoolId, purchaseId])
  @@index([schoolId, itemId])
  @@map("inventory_purchase_items")
}

model StockMovement {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId            String            @db.Uuid
  itemId              String            @db.Uuid
  campusId            String            @db.Uuid
  movementType        StockMovementType
  quantity            Int
  unitCost            Decimal           @default(0.00) @db.Decimal(12, 2)
  totalCost           Decimal           @default(0.00) @db.Decimal(12, 2)
  sourceCampusId      String?           @db.Uuid
  destinationCampusId String?           @db.Uuid
  recipientEmployeeId String?           @db.Uuid
  referenceType       String?           @db.VarChar(50)
  referenceId         String?           @db.Uuid
  notes               String?           @db.Text
  createdById         String            @db.Uuid
  createdAt           DateTime          @default(now()) @db.Timestamptz()

  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  campus            Campus        @relation(fields: [campusId], references: [id], onDelete: Restrict)
  recipientEmployee Employee?     @relation(fields: [recipientEmployeeId], references: [id], onDelete: SetNull)
  createdBy         User          @relation("CreatedStockMovements", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([id, schoolId])
  @@index([schoolId, itemId, campusId])
  @@index([schoolId, movementType])
  @@index([schoolId, createdAt])
  @@map("stock_movements")
}

model InventoryTransfer {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId            String   @db.Uuid
  transferNumber      String   @db.VarChar(50)
  itemId              String   @db.Uuid
  sourceCampusId      String   @db.Uuid
  destinationCampusId String   @db.Uuid
  quantity            Int
  transferDate        DateTime @default(now()) @db.Date
  reason              String?  @db.Text
  initiatedById       String   @db.Uuid
  status              String   @default("COMPLETED") @db.VarChar(20)
  createdAt           DateTime @default(now()) @db.Timestamptz()
  updatedAt           DateTime @default(now()) @updatedAt @db.Timestamptz()

  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  sourceCampus      Campus        @relation("TransferSourceCampus", fields: [sourceCampusId], references: [id], onDelete: Restrict)
  destinationCampus Campus        @relation("TransferDestinationCampus", fields: [destinationCampusId], references: [id], onDelete: Restrict)
  initiatedBy       User          @relation("InitiatedTransfers", fields: [initiatedById], references: [id], onDelete: Restrict)

  @@unique([id, schoolId])
  @@unique([schoolId, transferNumber])
  @@index([schoolId, itemId])
  @@map("inventory_transfers")
}

model Asset {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId            String          @db.Uuid
  itemId              String          @db.Uuid
  campusId            String          @db.Uuid
  assetCode           String          @db.VarChar(100)
  serialNumber        String?         @db.VarChar(100)
  barcode             String?         @db.VarChar(100)
  modelNumber         String?         @db.VarChar(100)
  purchaseDate        DateTime?       @db.Date
  purchaseCost        Decimal         @default(0.00) @db.Decimal(12, 2)
  warrantyExpiry      DateTime?       @db.Date
  currentCondition    AssetCondition  @default(NEW)
  status              AssetStatus     @default(AVAILABLE)
  assignedEmployeeId  String?         @db.Uuid
  locationClassroomId String?         @db.Uuid
  roomLocation        String?         @db.VarChar(150)
  disposalDate        DateTime?       @db.Date
  disposalReason      String?         @db.Text
  disposalValue       Decimal?        @db.Decimal(12, 2)
  disposedById        String?         @db.Uuid
  notes               String?         @db.Text
  createdAt           DateTime        @default(now()) @db.Timestamptz()
  updatedAt           DateTime        @default(now()) @updatedAt @db.Timestamptz()

  school            School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  item              InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  campus            Campus                @relation(fields: [campusId], references: [id], onDelete: Restrict)
  assignedEmployee  Employee?             @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  locationClassroom Classroom?            @relation(fields: [locationClassroomId], references: [id], onDelete: SetNull)
  disposedBy        User?                 @relation("DisposedAssets", fields: [disposedById], references: [id], onDelete: SetNull)
  assignments       AssetAssignment[]
  maintenanceLogs   AssetMaintenanceLog[]

  @@unique([id, schoolId])
  @@unique([schoolId, assetCode])
  @@index([schoolId, status])
  @@index([schoolId, itemId])
  @@index([schoolId, campusId])
  @@index([schoolId, assignedEmployeeId])
  @@map("assets")
}

model AssetAssignment {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId              String          @db.Uuid
  assetId               String          @db.Uuid
  employeeId            String?         @db.Uuid
  campusId              String?         @db.Uuid
  classroomId           String?         @db.Uuid
  locationName          String?         @db.VarChar(150)
  assignedDate          DateTime        @default(now()) @db.Timestamptz()
  returnedDate          DateTime?       @db.Timestamptz()
  conditionOnAssignment AssetCondition  @default(GOOD)
  conditionOnReturn     AssetCondition?
  assignedById          String          @db.Uuid
  notes                 String?         @db.Text
  createdAt             DateTime        @default(now()) @db.Timestamptz()
  updatedAt             DateTime        @default(now()) @updatedAt @db.Timestamptz()

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  asset      Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee   Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  campus     Campus?    @relation(fields: [campusId], references: [id], onDelete: SetNull)
  classroom  Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  assignedBy User       @relation("AssignedAssets", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([id, schoolId])
  @@index([schoolId, assetId])
  @@index([schoolId, employeeId])
  @@map("asset_assignments")
}

model AssetMaintenanceLog {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String    @db.Uuid
  assetId          String    @db.Uuid
  maintenanceType  String    @db.VarChar(100)
  serviceDate      DateTime  @db.Date
  vendorName       String?   @db.VarChar(150)
  issueDescription String?   @db.Text
  cost             Decimal   @default(0.00) @db.Decimal(12, 2)
  status           String    @default("COMPLETED") @db.VarChar(50)
  nextServiceDate  DateTime? @db.Date
  notes            String?   @db.Text
  createdById      String?   @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz()
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz()

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("CreatedAssetMaintenance", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([id, schoolId])
  @@index([schoolId, assetId])
  @@index([schoolId, serviceDate])
  @@map("asset_maintenance_logs")
}

// ============================================================================
// DOMAIN 26: ADVANCED REPORTING & ANALYTICS
// ============================================================================

model SavedReport {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String   @db.Uuid
  userId      String   @db.Uuid
  reportId    String   @db.VarChar(100)
  name        String   @db.VarChar(200)
  nameBn      String?  @db.VarChar(200)
  description String?  @db.Text
  filters     Json     @default("{}")
  columns     Json?
  sortBy      String?  @db.VarChar(100)
  sortOrder   String?  @default("ASC") @db.VarChar(10)
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz()

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, schoolId])
  @@index([schoolId, userId, reportId])
  @@map("saved_reports")
}

model ReportExportLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String   @db.Uuid
  userId      String   @db.Uuid
  reportId    String   @db.VarChar(100)
  format      String   @db.VarChar(20)
  filters     Json     @default("{}")
  resultCount Int      @default(0)
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz()

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, schoolId])
  @@index([schoolId, reportId, createdAt])
  @@index([schoolId, userId, createdAt])
  @@map("report_export_logs")
}


