  @@index([schoolId, category])
  @@map("file_attachments")
}

// ============================================================================
// DOMAIN 14: CERTIFICATES & TESTIMONIALS
// ============================================================================

model Certificate {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId          String @map("school_id")            @db.Uuid
  certificateNumber String @map("certificate_number")            @db.VarChar(50)
  certificateType   CertificateType @map("certificate_type")
  studentId         String @map("student_id")            @db.Uuid
  enrollmentId      String @map("enrollment_id")            @db.Uuid
  issueDate         DateTime @map("issue_date")          @db.Date
  leavingReason     String? @map("leaving_reason")           @db.Text
