  permanentDivision      Division @map("permanent_division")
  presentAddressLine     String @map("present_address_line")        @db.Text
  presentThana           String @map("present_thana")        @db.VarChar(100)
  presentDistrict        String @map("present_district")        @db.VarChar(100)
  presentDivision        Division @map("present_division")
