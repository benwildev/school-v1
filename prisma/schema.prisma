  practicalMarks        Decimal @map("practical_marks")      @default(0.00) @db.Decimal(5, 2)
  mcqMarks              Decimal @map("mcq_marks")      @default(30.00) @db.Decimal(5, 2)
  vivaMarks             Decimal @map("viva_marks")      @default(0.00) @db.Decimal(5, 2)
  totalFullMarks        Decimal @map("total_full_marks")      @default(100.00) @db.Decimal(5, 2)
