model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String? @map("school_id")    @db.Uuid
  email        String?    @db.VarChar(255)
  phone        String     @db.VarChar(30)
  passwordHash String @map("password_hash")     @db.VarChar(255)
  fullName     String @map("full_name")     @db.VarChar(200)
  avatarUrl    String? @map("avatar_url")    @db.Text
  isSuperAdmin Boolean @map("is_super_admin")    @default(false)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime? @map("last_login_at")  @db.Timestamptz()
  lastLoginIp  String? @map("last_login_ip")    @db.VarChar(45)
  createdAt    DateTime @map("created_at")   @default(now()) @db.Timestamptz()
  updatedAt    DateTime @map("updated_at")   @default(now()) @updatedAt @db.Timestamptz()
  deletedAt    DateTime? @map("deleted_at")  @db.Timestamptz()

  school                    School?                    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  userRoles                 UserRole[]
  teacherProfile            Teacher?
  guardians                 Guardian[]
  auditLogs                 AuditLog[]
  fileAttachments           FileAttachment[]
  notifications             Notification[]
  verifiedDocuments         StudentDocument[]
  markedStudentAttendances  StudentAttendance[]        @relation("MarkedStudentAttendances")
  updatedStudentAttendances StudentAttendance[]        @relation("UpdatedStudentAttendances")
  markedEmployeeAttendances EmployeeAttendance[]       @relation("MarkedEmployeeAttendances")
  employeeAttendances       EmployeeAttendance[]       @relation("EmployeeAttendanceUser")
  enteredMarks              Mark[]                     @relation("EnteredMarks")
  approvedMarks             Mark[]                     @relation("ApprovedMarks")
  voidedInvoices            StudentFee[]               @relation("VoidedInvoices")
  authorizedDiscounts       StudentDiscount[]          @relation("AuthorizedDiscounts")
  cancelledDiscounts        StudentDiscount[]          @relation("CancelledDiscounts")
  receivedPayments          Payment[]                  @relation("ReceivedPayments")
  verifiedPayments          Payment[]                  @relation("VerifiedPayments")
  issuedReceipts            Receipt[]                  @relation("IssuedReceipts")
  authorizedCreditTx        StudentCreditTransaction[] @relation("AuthorizedCreditTx")
  approvedRefunds           Refund[]                   @relation("ApprovedRefunds")
  approvedExpenses          Expense[]                  @relation("ApprovedExpenses")
  reviewedAdmissions        AdmissionApplication[]     @relation("ReviewedAdmissions")
  issuedCertificates        Certificate[]              @relation("IssuedCertificates")
  executedPromotions        PromotionBatch[]           @relation("ExecutedPromotions")
  studentUser               StudentUser?
  acceptedInvitations       AccountInvitation[]        @relation("AcceptedInvitations")
  createdInvitations        AccountInvitation[]        @relation("CreatedInvitations")
  employee                  Employee?
  verifiedEmployeeDocs      EmployeeDocument[]         @relation("VerifiedEmployeeDocs")
  approvedSalaryAssignments EmployeeSalaryAssignment[] @relation("ApprovedSalaryAssignments")
  actionedLeaveRequests     LeaveRequest[]             @relation("ActionedLeaveRequests")
  approvedSalaryAdvances    SalaryAdvance[]            @relation("ApprovedSalaryAdvances")
  finalizedPayrollPeriods   PayrollPeriod[]            @relation("FinalizedPayrollPeriods")
  generatedPayrollRecords   PayrollRecord[]            @relation("GeneratedPayrollRecords")
  finalizedPayrollRecords   PayrollRecord[]            @relation("FinalizedPayrollRecords")
  disbursedPayrollPayments  PayrollPayment[]           @relation("DisbursedPayrollPayments")
  approvedPayrollPayments   PayrollPayment[]           @relation("ApprovedPayrollPayments")
  verifiedStudentAttendances   StudentAttendance[]        @relation("VerifiedStudentAttendances")
  verifiedEmployeeAttendances  EmployeeAttendance[]       @relation("VerifiedEmployeeAttendances")
  attendanceCorrections        AttendanceCorrection[]
  notificationPreferences      NotificationPreference[]
  communicationCampaigns       CommunicationCampaign[]
  actedNotifications           Notification[]             @relation("NotificationActor")
  recordedBoardingEvents       TransportBoardingEvent[]   @relation("RecordedBoardingEvents")
  issuedLoans                  LibraryLoan[]              @relation("IssuedLoans")
  returnedLoans                LibraryLoan[]              @relation("ReturnedLoans")
  assessedLibraryFines         LibraryFine[]              @relation("AssessedLibraryFines")
  waivedLibraryFines           LibraryFine[]              @relation("WaivedLibraryFines")
  createdPurchases             InventoryPurchase[]        @relation("CreatedPurchases")
  createdStockMovements        StockMovement[]            @relation("CreatedStockMovements")
  initiatedTransfers           InventoryTransfer[]        @relation("InitiatedTransfers")
  disposedAssets               Asset[]                    @relation("DisposedAssets")
  assignedAssets               AssetAssignment[]          @relation("AssignedAssets")
  createdAssetMaintenance      AssetMaintenanceLog[]      @relation("CreatedAssetMaintenance")
  savedReports                 SavedReport[]
  reportExportLogs             ReportExportLog[]

  @@unique([id, schoolId])
  @@unique([schoolId, phone])
  @@unique([schoolId, email])
  @@index([schoolId, phone])
  @@index([email])
  @@map("users")
}

model Role {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String? @map("school_id")  @db.Uuid
  code         String   @db.VarChar(50)
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  isSystemRole Boolean @map("is_system_role")  @default(false)
  createdAt    DateTime @map("created_at") @default(now()) @db.Timestamptz()

  school          School?          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([id, schoolId])
  @@unique([schoolId, code])
  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module      PermissionModule
  action      PermissionAction
  code        String           @unique @db.VarChar(100)
  description String           @db.VarChar(255)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String @map("role_id")          @db.Uuid
  permissionId String @map("permission_id")          @db.Uuid
  scope        PermissionScope @default(ENTIRE_SCHOOL)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String @map("user_id")   @db.Uuid
  roleId    String @map("role_id")   @db.Uuid
  campusId  String? @map("campus_id")  @db.Uuid
  createdAt DateTime @map("created_at") @default(now()) @db.Timestamptz()

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, campusId])
  @@map("user_roles")
}

// ============================================================================
// DOMAIN 12: FORENSICS & AUDIT LOGS
// ============================================================================

model AuditLog {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String @map("school_id")      @db.Uuid
  requestId     String? @map("request_id")     @db.VarChar(100)
  sessionId     String? @map("session_id")     @db.VarChar(100)
  traceId       String? @map("trace_id")     @db.VarChar(100)
  actorUserId   String? @map("actor_user_id")     @db.Uuid
  actorName     String @map("actor_name")      @db.VarChar(150)
  actorRole     String @map("actor_role")      @db.VarChar(50)
  actorType     String @map("actor_type")      @default("USER") @db.VarChar(50)
  action        AuditAction
  entity        String      @db.VarChar(100)
  entityId      String @map("entity_id")      @db.VarChar(100)
  resourceUrn   String? @map("resource_urn")     @db.VarChar(255)
  beforeState   Json? @map("before_state")
  afterState    Json? @map("after_state")
  changeSummary String? @map("change_summary")     @db.Text
  ipAddress     String? @map("ip_address")     @db.VarChar(45)
  userAgent     String? @map("user_agent")     @db.Text
  timestamp     DateTime    @default(now()) @db.Timestamptz()

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  actor  User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([schoolId, entity, entityId])
  @@index([schoolId, actorUserId, timestamp])
  @@index([schoolId, timestamp])
  @@map("audit_logs")
}

// ============================================================================
// DOMAIN 13: CLOUD FILE ATTACHMENTS
