  createdAt             DateTime            @default(now()) @db.Timestamptz()
  updatedAt             DateTime            @default(now()) @updatedAt @db.Timestamptz()

  school           School                   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  period           PayrollPeriod            @relation(fields: [periodId], references: [id], onDelete: Restrict)
  employee         Employee                 @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  salaryAssignment EmployeeSalaryAssignment @relation(fields: [salaryAssignmentId], references: [id], onDelete: Restrict)
  campus           Campus?                  @relation(fields: [campusId], references: [id], onDelete: SetNull)
  department       Department               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designation      Designation              @relation(fields: [designationId], references: [id], onDelete: Restrict)
  generatedBy      User                     @relation("GeneratedPayrollRecords", fields: [generatedById], references: [id], onDelete: Restrict)
  finalizedBy      User?                    @relation("FinalizedPayrollRecords", fields: [finalizedById], references: [id], onDelete: SetNull)
  items            PayrollItem[]
  payments         PayrollPayment[]

  @@unique([id, schoolId])
  @@unique([schoolId, periodId, employeeId])
